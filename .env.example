# Live market data (Twelve Data). Free tier: 800 requests/day.
# Get a key at https://twelvedata.com/pricing
#
# WARNING: anything prefixed VITE_ is compiled into the public client bundle.
# A rate-limited, read-only market-data key is acceptable here. Nothing else is.
VITE_TWELVEDATA_KEY=

# Preferred for production: point this at your own serverless proxy that holds
# the key server-side and forwards /quote and /time_series. When set, the key
# above is not used or shipped.
# VITE_QUOTES_ENDPOINT=https://veylprotocol.com/api/market

# ---------------------------------------------------------------------------
# Wallet connection (dashboard only). Create a project at dashboard.reown.com.
# A Reown project id is a public client identifier: restrict it by domain in
# the Reown dashboard rather than treating it as a secret. Without it the
# dashboard shows setup instructions instead of a connect button.
VITE_REOWN_PROJECT_ID=

# Robinhood Chain RPC. Optional: the app falls back to the rate-limited public
# endpoints when these are unset. Use a dedicated provider in production.
# VITE_RPC_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# VITE_RPC_TESTNET=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY

# Point the dashboard at Robinhood Chain testnet (chain 46630) instead of
# mainnet (chain 4663).
# VITE_USE_TESTNET=true

# Protocol contracts. Set once deployed; the action forms read these at submit
# time and report a specific error if an address is missing.
VITE_VAULT_ADDRESS=

# Tokenized equity token addresses, as a JSON map keyed by ticker.
# Verified Robinhood Chain stock tokens are committed in .env.
# VITE_ASSET_ADDRESSES={"AAPL":"0x...","AMZN":"0x..."}

# Zama FHE relayer. Required to seal transfer amounts client side. Without it
# the transfer form refuses to submit rather than sending a readable amount.
VITE_FHE_RELAYER_URL=
